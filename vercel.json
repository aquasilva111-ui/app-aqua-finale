{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd social-app-main && pnpm install --frozen-lockfile",
  "buildCommand": "cd social-app-main && NODE_OPTIONS=--max-old-space-size=6144 pnpm build-web",
  "outputDirectory": "social-app-main/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
